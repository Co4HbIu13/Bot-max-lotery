# Max messenger bot configuration
BOT_TOKEN=test_token_for_local_testing
# Webhook URL where Max will send updates (public https or ngrok)
WEBHOOK_URL=http://localhost:3000/webhook
# Local server settings
PORT=3000
HOST=0.0.0.0

# SBP payment settings (YooKassa / CloudPayments / your gateway)
SBP_PROVIDER=stub
SBP_API_KEY=
SBP_SHOP_ID=
SBP_SECRET=
SBP_RETURN_URL=http://localhost:3000/sbp/return
# Currency for the lottery (RUB, USD, etc.)
LOTTERY_CURRENCY=RUB

# Database file path
DB_PATH=./data/lottery.db
