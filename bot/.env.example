# Max messenger bot configuration
BOT_TOKEN=your_max_bot_token
# Webhook URL where Max will send updates (public https or ngrok)
WEBHOOK_URL=https://your-domain.example.com/webhook
# Local server settings
PORT=3000
HOST=0.0.0.0

# SBP payment settings (YooKassa / CloudPayments / your gateway)
SBP_PROVIDER=yookassa # yookassa | cloudpayments | stub
SBP_API_KEY=your_api_key
SBP_SHOP_ID=your_shop_id
SBP_SECRET=your_secret
SBP_RETURN_URL=https://your-domain.example.com/sbp/return
# Currency for the lottery (RUB, USD, etc.)
LOTTERY_CURRENCY=RUB

# Database file path
DB_PATH=./data/lottery.dbBOT_TOKEN=your_max_bot_token
